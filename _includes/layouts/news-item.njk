---
layout: "layouts/news-layout.njk"
---

<article class="news-article">
  <p class="eyebrow">{{ title }}</p>
  <h1>{{ title }}</h1>
  <p class="meta">{{ category }} · {{ date | date("dd LLL yyyy") }} · {{ author }}</p>
  {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="" />
  {% endif %}
  <div class="article-body">
    {{ content | safe }}
  </div>
  <p><a href="/news/">← Volver a Noticias</a></p>
</article>
